{
  "name": "whoruled",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro check && tsc --noEmit -p pipeline/tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "pipeline:geo": "tsx pipeline/build-geo.ts",
    "pipeline:facts": "tsx pipeline/build-facts.ts",
    "import:leaders": "tsx pipeline/import-leaders.ts",
    "predev": "node scripts/clean-data.mjs && npm run pipeline:geo && npm run pipeline:facts",
    "prebuild": "node scripts/clean-data.mjs && npm run pipeline:geo && npm run pipeline:facts",
    "e2e": "node e2e/smoke.mjs"
  },
  "dependencies": {
    "@astrojs/check": "0.9.12",
    "@astrojs/react": "7.1.1",
    "@fontsource/im-fell-english": "5.3.0",
    "@fontsource/silkscreen": "5.3.0",
    "@fontsource/special-elite": "5.3.0",
    "@fontsource/vt323": "5.3.0",
    "astro": "7.4.2",
    "d3-geo": "3.1.1",
    "d3-selection": "3.0.0",
    "d3-zoom": "3.0.0",
    "qrcode-generator": "2.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "topojson-client": "3.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/d3-geo": "3.1.1",
    "@types/d3-selection": "3.0.12",
    "@types/d3-zoom": "3.0.9",
    "@types/geojson": "7946.0.16",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/topojson-client": "3.1.5",
    "@types/topojson-server": "3.0.4",
    "@types/topojson-specification": "1.0.5",
    "eslint": "10.13.0",
    "mapshaper": "0.7.98",
    "playwright-core": "1.64.1",
    "topojson-server": "3.0.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
