---
import '@fontsource/silkscreen/400.css';
import '@fontsource/vt323/400.css';
import fellUrl from '@fontsource/im-fell-english/files/im-fell-english-latin-400-normal.woff2?url';
import eliteUrl from '@fontsource/special-elite/files/special-elite-latin-400-normal.woff2?url';
import { themeCss } from '../map/theme';
import Consent from '../components/Consent.astro';
import { ADS_CLIENT, ANALYTICS_TOKEN, SITE_NAME, SITE_URL, SUPPORT_URL } from '../config/site';

interface Props {
  title: string;
  description: string;
  path: string;
  index?: boolean;
  fullHeight?: boolean;
  /** schema.org data for search engines (WebSite, BreadcrumbList, ...). */
  jsonLd?: Record<string, unknown>;
}
const { title, description, path, index = true, fullHeight = false, jsonLd } = Astro.props;
const canonical = new URL(path, SITE_URL).href;
const image = new URL('/og.png', SITE_URL).href;
// `<` is escaped so the data can never close the script element
const jsonLdText = jsonLd ? JSON.stringify(jsonLd).replace(/</g, '\\u003c') : '';
---
<!doctype html>
<html lang="en" data-era="modern">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={index ? 'index,follow' : 'noindex'} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="A map of the world's states with a year slider" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    {jsonLdText && <script type="application/ld+json" is:inline set:html={jsonLdText}></script>}
    <link rel="icon" href="data:," />
    <style
      is:inline
      set:html={`
      /* Era fonts are scaled so each reads at the size the pixel fonts were tuned for. */
      @font-face { font-family: 'Fell Fit'; src: url(${fellUrl}) format('woff2'); font-display: swap; size-adjust: 88%; }
      @font-face { font-family: 'Special Elite Fit'; src: url(${eliteUrl}) format('woff2'); font-display: swap; size-adjust: 72%; }
      ${themeCss()}`}
    />
    <style is:global>
      /* An EGA map room: sixteen colours, bevelled grey windows, DOS-blue panels. */
      :root {
        --black: #000000; --blue: #0000aa; --grey: #aaaaaa; --dgrey: #555555; --lblue: #5555ff;
        --cyan: #00aaaa; --lcyan: #55ffff; --yellow: #ffff55; --white: #ffffff;
        --hi: var(--white); --lo: var(--dgrey);
        --pixel: 'Silkscreen', 'Courier New', monospace; --body: 'VT323', 'Courier New', monospace;
        color-scheme: dark;
      }
      * { box-sizing: border-box; }
      html, body { background: var(--black); }
      body { margin: 0; font: 22px/1.25 var(--body); color: var(--white); display: flex; flex-direction: column; min-height: 100vh; min-height: 100dvh; padding: 6px; }
      body.full { height: 100vh; height: 100dvh; min-height: 0; }
      .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
      :focus-visible { outline: 2px solid var(--yellow); outline-offset: 1px; box-shadow: 0 0 0 4px var(--black); }

      /* Window chrome */
      .window { flex: 1; min-height: 0; display: flex; flex-direction: column; background: var(--texture, none), var(--grey); color: var(--black); border: 2px solid; border-color: var(--hi) var(--lo) var(--lo) var(--hi); }
      .titlebar { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 3px 8px; background: var(--blue); color: var(--yellow); }
      .titlebar h1 { margin: 0; font: 400 var(--head-size, 16px)/1.5 var(--pixel); }
      .titlebar a { color: inherit; text-decoration: none; }
      .titlebar .blurb { color: var(--white); font-size: 20px; line-height: 1; }
      .menubar { display: flex; flex-wrap: wrap; gap: 0 4px; padding: 1px 4px; border-bottom: 2px solid var(--lo); font-size: 22px; line-height: 1.2; }
      .menubar a { color: var(--black); text-decoration: none; padding: 0 8px; }
      .menubar a:hover, .menubar a[aria-current='page'] { background: var(--blue); color: var(--white); }
      .window-body { flex: 1; min-height: 0; display: flex; flex-direction: column; }
      .site-footer { padding: 2px 8px; border-top: 2px solid var(--lo); font-size: 18px; line-height: 1.15; color: var(--black); }
      .site-footer a { color: var(--blue); }
      .browse { margin-top: 2px; }
      .browse a { margin-right: 4px; }

      button { font: 22px/1 var(--body); color: var(--black); background: var(--grey); padding: 3px 10px 4px; cursor: pointer; border: 2px solid; border-color: var(--hi) var(--lo) var(--lo) var(--hi); box-shadow: 1px 1px 0 var(--black); }
      button:active:not(:disabled) { border-color: var(--lo) var(--hi) var(--hi) var(--lo); box-shadow: none; transform: translate(1px, 1px); }
      button:disabled { color: var(--dgrey); cursor: default; }
      button[aria-pressed='true'].play { background: var(--yellow); }
      button.link { background: none; border: 0; box-shadow: none; padding: 0; color: var(--lcyan); font: inherit; text-decoration: underline; text-underline-offset: 3px; }
      button.link:active:not(:disabled) { transform: none; }

      .boot { margin: 0; padding: 1rem; flex: 1; background: var(--black); color: var(--grey); }
      .boot::after { content: ''; display: inline-block; width: 0.5em; height: 0.9em; margin-left: 4px; vertical-align: -2px; background: var(--grey); animation: blink 1s steps(1) infinite; }
      @keyframes blink { 50% { visibility: hidden; } }

      /* Map screen */
      .map-layout { flex: 1; min-height: 0; display: grid; grid-template-columns: minmax(0, 1fr) 22rem; grid-template-rows: minmax(0, 1fr) auto auto; grid-template-areas: 'map side' 'time side' 'status side'; gap: 6px; padding: 6px; }
      .map-main { grid-area: map; position: relative; min-width: 0; border: 2px solid; border-color: var(--lo) var(--hi) var(--hi) var(--lo); background: var(--blue); overflow: hidden; }
      .map-main canvas { position: absolute; inset: 0; width: 100%; height: 100%; touch-action: none; cursor: crosshair; }
      .zoom-controls { position: absolute; top: 8px; left: 8px; display: flex; flex-direction: column; gap: 4px; }
      .zoom-controls button { min-width: 2.6rem; }
      .tooltip { position: absolute; pointer-events: none; padding: 2px 8px; background: var(--white); color: var(--black); border: 2px solid var(--black); box-shadow: 3px 3px 0 var(--black); font-size: 22px; line-height: 1; white-space: nowrap; z-index: 2; }
      .tooltip small { display: block; font-size: 18px; color: var(--dgrey); }

      .legend { position: absolute; left: 8px; bottom: 8px; max-width: 16rem; background: var(--grey); color: var(--black); border: 2px solid; border-color: var(--hi) var(--lo) var(--lo) var(--hi); box-shadow: 1px 1px 0 var(--black); font-size: 19px; line-height: 1.1; }
      .legend summary { padding: 2px 8px; cursor: pointer; list-style: none; }
      .legend summary::-webkit-details-marker { display: none; }
      .legend summary::before { content: '+ '; }
      .legend[open] summary { background: var(--blue); color: var(--white); }
      .legend[open] summary::before { content: '- '; }
      .legend ul { margin: 0; padding: 6px 8px 8px; list-style: none; display: grid; gap: 5px; }
      .legend li { display: grid; grid-template-columns: 1.4rem 1fr; gap: 8px; align-items: start; }
      .legend i { display: block; height: 14px; margin-top: 2px; border: 1px solid var(--black); }
      .key-realm { background: repeating-conic-gradient(var(--key-a) 0 25%, var(--key-b) 0 50%) 0 0 / 2px 2px; }
      .legend i.key-approx { height: 0; margin-top: 8px; background: none; border: 0; border-top: 2px dashed var(--black); }
      .key-wild { background: radial-gradient(circle at 1px 1px, var(--dgrey) 1px, transparent 1px) 0 0 / 4px 4px, var(--grey); }
      .key-chosen { background: repeating-conic-gradient(var(--white) 0 25%, var(--key-c) 0 50%) 0 0 / 2px 2px; outline: 2px dashed var(--yellow); outline-offset: -2px; }

      /* The advisor: a DOS-blue panel */
      .map-side { grid-area: side; display: flex; flex-direction: column; gap: 6px; min-height: 0; padding: 6px; background: var(--blue); color: var(--white); border: 2px solid; border-color: var(--lo) var(--hi) var(--hi) var(--lo); }
      .side-tools { display: flex; gap: 6px; }
      .side-tools label { flex: 1; min-width: 0; }
      .map-side input { display: block; width: 100%; padding: 2px 6px; font: 22px/1.1 var(--body); color: var(--black); background: var(--white); border: 2px solid; border-color: var(--lo) var(--hi) var(--hi) var(--lo); border-radius: 0; }
      .map-side input::placeholder { color: var(--dgrey); }
      .surprise { white-space: nowrap; background: var(--yellow); }
      .state-list { flex: 1 1 8rem; min-height: 6rem; margin: 0; padding: 2px; overflow: auto; list-style: none; border: 4px double var(--grey); background: var(--black); scrollbar-color: var(--grey) var(--black); }
      .state-list button { display: flex; align-items: center; gap: 8px; width: 100%; padding: 1px 6px; text-align: left; font-size: 21px; line-height: 1.1; color: var(--white); background: none; border: 0; box-shadow: none; }
      .state-list button:hover { background: var(--dgrey); }
      .state-list button[aria-pressed='true'] { background: var(--cyan); color: var(--black); }
      .state-list button:active:not(:disabled) { transform: none; }
      .state-list button:focus-visible { outline: 2px solid var(--yellow); outline-offset: -2px; box-shadow: none; }
      .state-list .empty { padding: 4px 6px; color: var(--grey); font-size: 20px; }
      .swatch { flex: none; width: 12px; height: 12px; border: 1px solid var(--white); }
      .detail { flex: 1 1 13rem; min-height: 8rem; overflow: auto; padding: 6px 10px 8px; border: 4px double var(--grey); scrollbar-color: var(--grey) var(--blue); }
      .detail h2 { margin: 2px 0 6px; font: 400 var(--head-size, 16px)/1.5 var(--pixel); color: var(--yellow); }
      .detail h3 { margin: 10px 0 2px; font: inherit; color: var(--lcyan); }
      .detail p { margin: 4px 0; }
      .detail ul { margin: 0; padding-left: 1.1rem; }
      .detail li { margin: 2px 0; }
      .detail a { color: var(--lcyan); text-underline-offset: 3px; }
      .detail .back { display: none; margin-bottom: 6px; }
      .overview .largest { padding: 0; list-style: none; }
      .overview .largest li { display: flex; align-items: center; gap: 8px; }
      .overview .largest button { text-align: left; }
      .overview .hint { margin-top: 12px; color: var(--grey); font-size: 20px; }
      .reviewed { color: var(--grey); font-size: 19px; }

      /* Timeline */
      .year-slider { grid-area: time; display: grid; grid-template-columns: auto auto minmax(0, 1fr); align-items: center; gap: 12px; padding: 2px 4px; }
      .lcd { min-width: 9rem; padding: 2px 10px 4px; background: var(--black); border: 2px solid; border-color: var(--lo) var(--hi) var(--hi) var(--lo); text-align: right; }
      .lcd output { display: block; font-size: 44px; line-height: 0.95; color: var(--yellow); font-variant-numeric: tabular-nums; }
      .lcd span { display: block; font-size: 18px; line-height: 1; color: var(--grey); white-space: nowrap; }
      .transport { display: flex; gap: 4px; }
      .transport .play { min-width: 4.4rem; }
      .ruler { position: relative; min-width: 0; padding: 0 10px 22px; }
      .ruler input[type='range'] { -webkit-appearance: none; appearance: none; display: block; width: 100%; height: 24px; margin: 0; padding: 0; background: transparent; border: 0; }
      .ruler input[type='range']::-webkit-slider-runnable-track { height: 8px; background: var(--black); border: 2px solid; border-color: var(--lo) var(--hi) var(--hi) var(--lo); }
      .ruler input[type='range']::-moz-range-track { height: 8px; background: var(--black); border: 2px solid; border-color: var(--lo) var(--hi) var(--hi) var(--lo); }
      .ruler input[type='range']::-webkit-slider-thumb { -webkit-appearance: none; width: 14px; height: 24px; margin-top: -10px; background: var(--grey); border: 2px solid; border-color: var(--hi) var(--lo) var(--lo) var(--hi); border-radius: 0; box-shadow: 1px 1px 0 var(--black); }
      .ruler input[type='range']::-moz-range-thumb { width: 10px; height: 20px; background: var(--grey); border: 2px solid; border-color: var(--hi) var(--lo) var(--lo) var(--hi); border-radius: 0; }
      .ruler input[type='range']:focus-visible { outline-offset: 2px; }
      .ticks { position: absolute; left: 17px; right: 17px; top: 24px; height: 22px; pointer-events: none; }
      .ticks span { position: absolute; left: calc(100% * var(--p)); top: 0; transform: translateX(-50%); padding-top: 7px; font-size: 18px; line-height: 1; white-space: nowrap; color: var(--black); }
      .ticks span::before { content: ''; position: absolute; left: 50%; top: 0; width: 2px; height: 4px; margin-left: -1px; background: var(--dgrey); }
      .ticks span.major::before { height: 6px; background: var(--black); }
      .ticks span.first { transform: translateX(-8px); }
      .ticks span.first::before { left: 8px; }
      .ticks span.last { transform: translateX(calc(-100% + 8px)); }
      .ticks span.last::before { left: calc(100% - 8px); }
      .status-bar { grid-area: status; display: flex; justify-content: space-between; gap: 1rem; padding: 0 8px; border: 2px solid; border-color: var(--lo) var(--hi) var(--hi) var(--lo); font-size: 20px; line-height: 1.2; color: var(--black); white-space: nowrap; overflow: hidden; }
      .status-bar span:first-child { overflow: hidden; text-overflow: ellipsis; }

      /* Text pages: white paper in a grey window */
      .page { flex: 1; width: 100%; max-width: 46rem; margin: 6px auto; padding: 12px 20px 20px; line-height: 1.3; background: var(--white); color: var(--black); border: 2px solid; border-color: var(--lo) var(--hi) var(--hi) var(--lo); overflow: auto; }
      .page h2 { margin: 1.4rem 0 0.4rem; font: 400 var(--head-size, 16px)/1.5 var(--pixel); color: var(--blue); }
      .page h2:first-child { margin-top: 0; }
      .page a { color: var(--blue); text-underline-offset: 3px; }
      .page table { width: 100%; border-collapse: collapse; }
      .page th, .page td { padding: 2px 6px; text-align: left; border: 1px solid var(--dgrey); vertical-align: top; }
      .page th { background: var(--grey); font-weight: 400; }
      .note { padding: 6px 10px; border: 2px solid; border-color: var(--lo) var(--hi) var(--hi) var(--lo); background: var(--grey); color: var(--black); }
      .note a { color: var(--blue); }

      @media (max-width: 760px) {
        body { padding: 0; }
        .titlebar .blurb { display: none; }
        .site-footer { font-size: 18px; }
        body.full .site-footer .credits { display: none; }
        .menubar { font-size: 20px; }
        .map-layout { grid-template-columns: minmax(0, 1fr); grid-template-rows: minmax(12rem, 1fr) auto minmax(9rem, 34%); grid-template-areas: 'map' 'time' 'side'; padding: 4px; gap: 4px; }
        .status-bar { display: none; }
        .year-slider { grid-template-columns: auto 1fr; gap: 4px 8px; padding: 0; }
        .transport { justify-content: flex-end; }
        .transport button { padding-inline: 8px; }
        .ruler { grid-column: 1 / -1; }
        .lcd { min-width: 0; }
        .lcd output { font-size: 36px; }
        .legend { max-width: calc(100% - 16px); }
        .map-side[data-view='detail'] .state-list, .map-side[data-view='detail'] .side-tools { display: none; }
        .map-side[data-view='list'] .detail { display: none; }
        .detail .back { display: inline-block; }
        .page { margin: 0; border: 0; padding: 12px 16px; }
      }
      @media (prefers-reduced-motion: no-preference) {
        .window, .window * { transition: background-color 0.5s ease, color 0.5s ease, border-color 0.5s ease; }
      }
      @media (prefers-reduced-motion: reduce) {
        * { scroll-behavior: auto !important; }
        .boot::after { animation: none; }
      }
    </style>
    {ANALYTICS_TOKEN && <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: ANALYTICS_TOKEN })}></script>}
  </head>
  <body class={fullHeight ? 'full' : ''} data-ads={ADS_CLIENT ? 'on' : 'off'}>
    <div class="window">
      <div class="titlebar">
        <h1><a href="/">{SITE_NAME}</a></h1>
        <span class="blurb">Who ruled where, 1000 BC to today</span>
      </div>
      <nav class="menubar" aria-label="Site">
        <a href="/" aria-current={path === '/' ? 'page' : undefined}>Map</a>
        <a href="/about/" aria-current={path === '/about/' ? 'page' : undefined}>About</a>
        <a href="/privacy/" aria-current={path === '/privacy/' ? 'page' : undefined}>Privacy</a>
        {SUPPORT_URL && <a href={SUPPORT_URL} target={SUPPORT_URL.startsWith('/') ? undefined : '_blank'} rel={SUPPORT_URL.startsWith('/') ? undefined : 'noopener noreferrer'} aria-current={path === '/support/' ? 'page' : undefined}>Support this project</a>}
      </nav>
      <div class="window-body"><slot /></div>
      <footer class="site-footer">
        <span class="credits">
          Borders: <a href="https://github.com/aourednik/historical-basemaps" target="_blank" rel="noopener noreferrer">historical-basemaps</a> (GPL-3.0) to 2010; <a href="https://www.naturalearthdata.com/" target="_blank" rel="noopener noreferrer">Natural Earth</a> (public domain) for 2026.
          Office-holders: <a href="https://en.wikipedia.org/wiki/Lists_of_state_leaders" target="_blank" rel="noopener noreferrer">Wikipedia</a> lists (CC BY-SA 4.0) and Wikidata (CC0).
        </span>{' '}
        <a href="/about/">About &amp; licences</a>
        <slot name="footer" />
      </footer>
    </div>
    <Consent />
  </body>
</html>
