---
import '@fontsource/silkscreen/400.css';
import '@fontsource/silkscreen/700.css';
import '@fontsource/vt323/400.css';
import Consent from '../components/Consent.astro';
import { ADS_CLIENT, ANALYTICS_TOKEN, SITE_NAME, SITE_URL, SUPPORT_URL } from '../config/site';

interface Props {
  title: string;
  description: string;
  path: string;
  index?: boolean;
  fullHeight?: boolean;
}
const { title, description, path, index = true, fullHeight = false } = Astro.props;
const canonical = new URL(path, SITE_URL).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={index ? 'index,follow' : 'noindex'} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <link rel="icon" href="data:," />
    <style is:global>
      :root {
        --ocean: #1a2a9a; --navy: #0b0b6e; --panel: #10107a; --chrome: #b9b9cc;
        --hi: #f4f4ff; --lo: #3a3a55; --ink: #0b0b1a; --gold: #ffff55; --cyan: #55ffff; --mute: #aaaaaa;
        --pixel: 'Silkscreen', 'Courier New', monospace; --body: 'VT323', 'Courier New', monospace;
        color-scheme: dark;
      }
      * { box-sizing: border-box; }
      html { background: #2b2b5e; }
      body { margin: 0; font: 20px/1.3 var(--body); color: #fff; background: #2b2b5e; image-rendering: pixelated; }
      body { display: flex; flex-direction: column; min-height: 100vh; min-height: 100dvh; padding: 6px; }
      body.full { height: 100vh; height: 100dvh; min-height: 0; }
      .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
      .window { flex: 1; min-height: 0; display: flex; flex-direction: column; background: var(--chrome); color: var(--ink); border: 2px solid; border-color: var(--hi) var(--lo) var(--lo) var(--hi); box-shadow: 4px 4px 0 #0b0b1a99; }
      .titlebar { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; padding: 0.2rem 0.5rem; background: var(--navy); color: var(--gold); font: 700 13px/1.6 var(--pixel); }
      .titlebar h1 { margin: 0; font: inherit; }
      .titlebar a { color: inherit; text-decoration: none; }
      .titlebar .blurb { color: #fff; font: 18px/1 var(--body); opacity: 0.85; }
      .menubar { display: flex; flex-wrap: wrap; gap: 0.25rem 1rem; padding: 0.15rem 0.5rem; border-bottom: 2px solid var(--lo); font: 700 11px/1.8 var(--pixel); }
      .menubar a { color: var(--ink); text-decoration: none; padding: 0 0.3rem; }
      .menubar a:hover, .menubar a[aria-current='page'] { background: var(--navy); color: var(--gold); }
      a:focus-visible, button:focus-visible, input:focus-visible { outline: 2px dashed var(--navy); outline-offset: 2px; }
      .window-body { flex: 1; min-height: 0; display: flex; flex-direction: column; }
      .site-footer { padding: 0.25rem 0.5rem; border-top: 2px solid var(--lo); font-size: 16px; line-height: 1.15; color: var(--ink); }
      .site-footer a { color: var(--navy); }

      button { font: 700 11px/1.2 var(--pixel); color: var(--ink); background: var(--chrome); padding: 0.4rem 0.7rem; cursor: pointer; border: 2px solid; border-color: var(--hi) var(--lo) var(--lo) var(--hi); }
      button:active:not(:disabled) { border-color: var(--lo) var(--hi) var(--hi) var(--lo); padding: calc(0.4rem + 1px) calc(0.7rem - 1px) calc(0.4rem - 1px) calc(0.7rem + 1px); }
      button:disabled { color: #70708a; cursor: default; }
      button[aria-pressed='true'].play { background: var(--gold); }

      .boot { padding: 1rem; margin: 0; }
      .map-shell { flex: 1; min-height: 0; display: flex; flex-direction: column; }
      .map-layout { display: grid; grid-template-columns: 1fr 21rem; flex: 1; min-height: 0; padding: 6px; gap: 6px; }
      .map-main { position: relative; min-width: 0; border: 2px solid; border-color: var(--lo) var(--hi) var(--hi) var(--lo); background: var(--ocean); overflow: hidden; }
      .map-main canvas { position: absolute; inset: 0; width: 100%; height: 100%; touch-action: none; cursor: crosshair; }
      .zoom-controls { position: absolute; top: 8px; left: 8px; display: flex; flex-direction: column; gap: 4px; }
      .zoom-controls button { min-width: 2.4rem; }
      .tooltip { position: absolute; pointer-events: none; padding: 0.1rem 0.5rem; background: var(--hi); color: var(--ink); border: 2px solid var(--ink); font-size: 20px; white-space: nowrap; z-index: 2; }
      .map-side { display: flex; flex-direction: column; gap: 6px; min-height: 0; padding: 6px; background: var(--panel); color: #fff; border: 2px solid; border-color: var(--lo) var(--hi) var(--hi) var(--lo); }
      .side-tools { display: flex; gap: 6px; }
      .side-tools label { flex: 1; min-width: 0; }
      .map-side input { display: block; width: 100%; padding: 0.15rem 0.4rem; font: 20px var(--body); color: var(--ink); background: var(--hi); border: 2px solid; border-color: var(--lo) var(--hi) var(--hi) var(--lo); }
      .surprise { white-space: nowrap; background: var(--gold); }
      .state-list { flex: 1 1 8rem; margin: 0; padding: 0; overflow: auto; list-style: none; border: 2px solid var(--ink); background: #0a0a50; min-height: 6rem; }
      .state-list button { display: flex; align-items: center; gap: 0.5rem; width: 100%; padding: 0.05rem 0.4rem; text-align: left; font: 20px/1.2 var(--body); color: #fff; background: none; border: 0; }
      .state-list button:hover { background: #2a2aa0; }
      .state-list button[aria-pressed='true'] { background: var(--gold); color: var(--ink); }
      .state-list button:focus-visible { outline: 2px dashed var(--gold); outline-offset: -2px; }
      .swatch { flex: none; width: 0.7rem; height: 0.7rem; border: 1px solid var(--ink); }
      .detail { flex: 1 1 12rem; min-height: 8rem; overflow: auto; padding: 0.4rem 0.5rem; border: 2px solid var(--ink); background: var(--navy); }
      .detail h2 { margin: 0 0 0.3rem; font: 700 13px/1.5 var(--pixel); color: var(--gold); }
      .detail h3 { margin: 0.6rem 0 0.1rem; font: 700 11px/1.5 var(--pixel); color: var(--cyan); }
      .detail p { margin: 0.2rem 0; }
      .detail ul { margin: 0; padding-left: 1.1rem; }
      .detail a { color: var(--cyan); }
      .detail button.link { background: none; border: 0; padding: 0; color: var(--cyan); font: inherit; text-decoration: underline; }
      .detail button.link:focus-visible { outline: 2px dashed var(--gold); }
      .unreviewed { color: var(--mute); font-size: 17px; }

      .year-slider { display: grid; grid-template-columns: auto auto 1fr; align-items: center; gap: 0.75rem; padding: 6px 8px 4px; border-top: 2px solid var(--lo); }
      .lcd { min-width: 8.5rem; padding: 0.1rem 0.6rem; background: #05050f; border: 2px solid; border-color: var(--lo) var(--hi) var(--hi) var(--lo); text-align: right; }
      .lcd output { display: block; font-size: 38px; line-height: 1; color: var(--gold); font-variant-numeric: tabular-nums; }
      .lcd span { display: block; font-size: 16px; line-height: 1; color: var(--mute); white-space: nowrap; }
      .transport { display: flex; gap: 4px; }
      .ruler { position: relative; min-width: 0; padding-bottom: 1.3rem; }
      .ruler input[type='range'] { -webkit-appearance: none; appearance: none; width: 100%; height: 24px; margin: 0; padding: 0; background: transparent; border: 0; }
      .ruler input[type='range']::-webkit-slider-runnable-track { height: 8px; background: #05050f; border: 2px solid; border-color: var(--lo) var(--hi) var(--hi) var(--lo); }
      .ruler input[type='range']::-moz-range-track { height: 8px; background: #05050f; border: 2px solid; border-color: var(--lo) var(--hi) var(--hi) var(--lo); }
      .ruler input[type='range']::-webkit-slider-thumb { -webkit-appearance: none; width: 14px; height: 24px; margin-top: -10px; background: var(--chrome); border: 2px solid; border-color: var(--hi) var(--lo) var(--lo) var(--hi); border-radius: 0; }
      .ruler input[type='range']::-moz-range-thumb { width: 10px; height: 20px; background: var(--chrome); border: 2px solid; border-color: var(--hi) var(--lo) var(--lo) var(--hi); border-radius: 0; }
      .ticks { position: absolute; left: 0; right: 0; top: 26px; height: 1.2rem; pointer-events: none; }
      .ticks span { position: absolute; left: calc(7px + (100% - 14px) * var(--p)); top: 0; transform: translateX(-50%); padding-top: 5px; font-size: 16px; line-height: 1; white-space: nowrap; color: var(--ink); border-left: 2px solid var(--lo); height: 5px; }
      .ticks span.major { border-left-color: var(--ink); }
      .ticks span.major { height: auto; }
      .status-bar { display: flex; justify-content: space-between; gap: 1rem; padding: 0.05rem 0.5rem; margin: 0 6px 6px; border: 2px solid; border-color: var(--lo) var(--hi) var(--hi) var(--lo); font-size: 18px; line-height: 1.2; color: var(--ink); }

      .page { flex: 1; width: 100%; max-width: 48rem; margin: 0 auto; padding: 1rem; font-size: 21px; line-height: 1.35; background: var(--hi); color: var(--ink); overflow: auto; }
      .page h2 { margin: 1.25rem 0 0.4rem; font: 700 13px/1.5 var(--pixel); color: var(--navy); }
      .page h2:first-child { margin-top: 0; }
      .page a { color: #0000b0; }
      .page table { width: 100%; border-collapse: collapse; }
      .page th, .page td { padding: 0.15rem 0.4rem; text-align: left; border: 1px solid var(--lo); vertical-align: top; }
      .page th { background: var(--chrome); font: 700 11px/1.5 var(--pixel); }
      .note { padding: 0.4rem 0.6rem; border: 2px solid; border-color: var(--lo) var(--hi) var(--hi) var(--lo); background: var(--chrome); }

      @media (max-width: 760px) {
        body { padding: 0; }
        .titlebar .blurb { display: none; }
        .map-layout { grid-template-columns: 1fr; grid-template-rows: minmax(0, 1fr) minmax(0, 1fr); }
        .year-slider { grid-template-columns: auto 1fr; }
        .ruler { grid-column: 1 / -1; }
        .lcd { min-width: 7rem; }
      }
      @media (prefers-reduced-motion: reduce) { * { scroll-behavior: auto !important; } }
    </style>
    {ANALYTICS_TOKEN && <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: ANALYTICS_TOKEN })}></script>}
  </head>
  <body class={fullHeight ? 'full' : ''} data-ads={ADS_CLIENT ? 'on' : 'off'}>
    <div class="window">
      <div class="titlebar">
        <h1><a href="/">{SITE_NAME}</a></h1>
        <span class="blurb">Who ruled where, 1000 BC to 2010</span>
      </div>
      <nav class="menubar" aria-label="Site">
        <a href="/" aria-current={path === '/' ? 'page' : undefined}>Map</a>
        <a href="/about/" aria-current={path === '/about/' ? 'page' : undefined}>About</a>
        <a href="/privacy/" aria-current={path === '/privacy/' ? 'page' : undefined}>Privacy</a>
        {SUPPORT_URL && <a href={SUPPORT_URL} rel="noopener noreferrer">Support this project</a>}
      </nav>
      <div class="window-body"><slot /></div>
      <footer class="site-footer">
        Borders: <a href="https://github.com/aourednik/historical-basemaps">historical-basemaps</a> (GPL-3.0).
        Office-holders: <a href="https://en.wikipedia.org/wiki/Lists_of_state_leaders">Wikipedia</a> lists (CC BY-SA 4.0) and Wikidata (CC0).
        Facts are sourced but not all are human-reviewed. <a href="/about/">About &amp; licences</a>
      </footer>
    </div>
    <Consent />
  </body>
</html>
