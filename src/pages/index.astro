---
import MapIsland from '../components/MapIsland';
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <link rel="icon" href="data:," />
    <title>WhoRuled</title>
    <style is:global>
      :root { color-scheme: light dark; font-family: system-ui, sans-serif; }
      body { margin: 0; }
      header { padding: 0.75rem 1rem; border-bottom: 1px solid #8884; }
      h1 { margin: 0; font-size: 1.25rem; }
      .map-shell { display: flex; flex-direction: column; height: calc(100vh - 3.2rem); }
      .year-slider { display: flex; align-items: center; gap: 0.75rem; padding: 0.5rem 0.75rem; border-bottom: 1px solid #8884; }
      .year-slider input { flex: 1; min-width: 0; }
      .year-slider output { min-width: 5ch; font-variant-numeric: tabular-nums; font-weight: 700; text-align: right; }
      .map-layout { display: grid; grid-template-columns: 1fr 20rem; flex: 1; min-height: 0; }
      .map-main { position: relative; min-width: 0; background: #cfe3ee; }
      .map-main canvas { position: absolute; inset: 0; width: 100%; height: 100%; touch-action: none; cursor: grab; }
      .map-side { display: flex; flex-direction: column; gap: 0.5rem; padding: 0.75rem; overflow: hidden; border-left: 1px solid #8884; }
      .map-side input { display: block; width: 100%; box-sizing: border-box; margin-top: 0.25rem; padding: 0.4rem; }
      .state-list { flex: 1; margin: 0; padding: 0; overflow: auto; list-style: none; }
      .state-list button { width: 100%; padding: 0.35rem 0.25rem; text-align: left; background: none; border: 0; border-bottom: 1px solid #8882; color: inherit; cursor: pointer; }
      .state-list button[aria-pressed='true'] { font-weight: 700; }
      .detail h2 { margin: 0 0 0.25rem; font-size: 1.1rem; }
      .detail h3 { margin: 0.75rem 0 0.25rem; font-size: 0.95rem; }
      .detail ul { margin: 0; padding-left: 1.1rem; }
      .detail a { color: #8ab4f8; }
      .detail button.link { background: none; border: 0; padding: 0; color: #8ab4f8; text-decoration: underline; cursor: pointer; font: inherit; }
      .unreviewed { opacity: 0.7; font-size: 0.85rem; }
      @media (max-width: 700px) {
        .map-layout { grid-template-columns: 1fr; grid-template-rows: 55% 45%; }
        .map-side { border-left: 0; border-top: 1px solid #8884; }
      }
    </style>
  </head>
  <body>
    <header><h1>WhoRuled</h1></header>
    <MapIsland client:load />
  </body>
</html>
