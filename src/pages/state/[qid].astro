---
import type { GetStaticPaths } from 'astro';
import { browseYears, loadFacts } from '../../data/browseYears';
import { correctionUrl, formatYear } from '../../map/format';
import { isIndexable, type Polity } from '../../data/schema';
import AdSlot from '../../components/AdSlot.astro';
import Base from '../../layouts/Base.astro';
import { AFFILIATE_DISCLOSURE, AMAZON_TAG, SITE_URL, booksUrl } from '../../config/site';

export const getStaticPaths = (() => {
  const { polities } = loadFacts();
  return polities.map((polity) => ({ params: { qid: polity.qid }, props: { polity } }));
}) satisfies GetStaticPaths;

interface Props {
  polity: Polity;
}
const { polity } = Astro.props;
const { index } = loadFacts();
const onMap = Object.entries(index)
  .filter(([, names]) => Object.values(names).includes(polity.qid))
  .map(([year]) => Number(year))
  .sort((a, b) => a - b);
const pageYears = new Set(browseYears());
const span = (r: { from: number; to: number | null }) =>
  `${formatYear(r.from)}–${r.to === null ? 'present' : formatYear(r.to)}`;
const lead = polity.rulers[0];
const description = (
  lead
    ? `Who ruled ${polity.name}: ${lead.name} (${lead.title}, ${span(lead)})${polity.rulers.length > 1 ? ' and others' : ''}. Sourced rulers, government and events.`
    : `Rulers, government and events for ${polity.name}, with sources.`
).slice(0, 300);
---
<Base
  title={`Who ruled ${polity.name}? Rulers and government | WhoRuled`}
  description={description}
  path={`/state/${polity.qid}/`}
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'WhoRuled', item: new URL('/', SITE_URL).href },
      { '@type': 'ListItem', position: 2, name: polity.name, item: new URL(`/state/${polity.qid}/`, SITE_URL).href },
    ],
  }}
  index={isIndexable(polity)}
>
  <main class="page">
    <h2 style="margin-top:0">{polity.name}</h2>
    <p>{polity.summary}</p>
    {polity.rulers.length > 0 && (
      <>
        <h2>Rulers</h2>
        <table>
          <thead><tr><th>Name</th><th>Title</th><th>Years</th><th>Source</th></tr></thead>
          <tbody>
            {polity.rulers.map((r) => (
              <tr><td>{r.name}</td><td>{r.title}</td><td>{span(r)}</td><td><a href={r.source.url} target="_blank" rel="noopener noreferrer">source</a></td></tr>
            ))}
          </tbody>
        </table>
      </>
    )}
    {polity.offices.length > 0 && (
      <>
        <h2>Government below the ruler</h2>
        <table>
          <thead><tr><th>Name</th><th>Office</th><th>Years</th><th>Source</th></tr></thead>
          <tbody>
            {polity.offices.map((o) => (
              <tr><td>{o.name}</td><td>{o.title}</td><td>{span(o)}</td><td><a href={o.source.url} target="_blank" rel="noopener noreferrer">source</a></td></tr>
            ))}
          </tbody>
        </table>
      </>
    )}
    {polity.armySize && (
      <p>
        Army: about {polity.armySize.value.toLocaleString('en')} ({formatYear(polity.armySize.year)}, {polity.armySize.confidence} confidence)
        <a href={polity.armySize.source.url} target="_blank" rel="noopener noreferrer"> source</a>
      </p>
    )}
    {polity.events.length > 0 && (
      <>
        <h2>Events</h2>
        <ul>
          {polity.events.map((e) => (
            <li>{formatYear(e.year)}: {e.summary} <a href={e.source.url} target="_blank" rel="noopener noreferrer">source</a></li>
          ))}
        </ul>
      </>
    )}
    <p class="note">
      {polity.review !== undefined && `Reviewed by ${polity.review.by} on ${polity.review.date}. `}Every entry above links to its source. Spot an error? <a href={correctionUrl(polity.name, null)} target="_blank" rel="noopener noreferrer">Report it</a>.
    </p>
    {onMap.some((y) => pageYears.has(y)) && (
      <p>
        See it among the world's states in:{' '}
        {onMap.filter((y) => pageYears.has(y)).map((y, i) => <>{i > 0 && ', '}<a href={`/year/${y}/`}>{formatYear(y)}</a></>)}.
      </p>
    )}
    {AMAZON_TAG && (
      <p>
        Read more: <a href={booksUrl(polity.name, AMAZON_TAG)} target="_blank" rel="sponsored noopener noreferrer">books about {polity.name} on Amazon</a>
        <br /><small>{AFFILIATE_DISCLOSURE}</small>
      </p>
    )}
    <AdSlot />
    <p><a href="/">← Back to the map</a></p>
  </main>
</Base>
